{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "shuaibshullar/laravel-vite-directory",
    "description": "",
    "keywords": [
        "laravel",
        "shuaibshullar",
        "laravel-vite-directory"
    ],
    "homepage": "https://github.com/vendor-name/laravel-vite-directory",
    "license": "MIT",
    "authors": [
        {
            "name": "Shuaib Shullar",
            "email": "shuaibshullar5@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/support": "^12.0||^13.0"
    },
    "require-dev": {
        "laravel/chisel": "^0.1",
        "laravel/prompts": "^0.3",
        "orchestra/testbench": "^10.0||^11.0",
        "pestphp/pest": "^4.6||^5.0",
        "pestphp/pest-plugin-laravel": "^4.1||^5.0",
        "pestphp/pest-plugin-type-coverage": "^4.0||^5.0"
    },
    "autoload": {
        "psr-4": {
            "LaravelViteDirectory\\LaravelViteDirectory\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LaravelViteDirectory\\LaravelViteDirectory\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Factories\\": "workbench/database/factories/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@clear",
            "@prepare"
        ],
        "prepare": [
            "@php vendor/bin/testbench package:discover --ansi"
        ],
        "build": [
            "@php vendor/bin/testbench workbench:build --ansi"
        ],
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@build",
            "@php vendor/bin/testbench serve --ansi"
        ],
        "test:types": [
            "vendor/bin/pest --type-coverage --min=100"
        ],
        "test:unit": [
            "vendor/bin/pest --parallel"
        ],
        "test": [
            "@test:types",
            "@test:unit"
        ],
        "clear": [
            "@php vendor/bin/testbench package:purge-skeleton --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "LaravelViteDirectory\\LaravelViteDirectory\\LaravelViteDirectoryServiceProvider"
            ],
            "aliases": {
                "LaravelViteDirectory": "LaravelViteDirectory\\LaravelViteDirectory\\Facades\\LaravelViteDirectory"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
